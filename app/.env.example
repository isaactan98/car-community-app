# Where the Runs backend lives. Copy this file to `.env.local` and set your
# real value there (`.env.local` is git-ignored; this example is committed).
#
# Expo inlines any EXPO_PUBLIC_* var into the app bundle at build time, so this
# is NOT a secret — do not put tokens/passwords in EXPO_PUBLIC_* vars.
#
# Pick the value that matches how you run the app:
#   Release builds (phones):        https://cca-backend.isaactan.work
#   Same machine (Expo web / sim):  http://localhost:4000
#   Android emulator -> host:       http://10.0.2.2:4000
#
# Release builds block cleartext, so any http:// URL other than localhost only
# works in a Debug build (Android debug manifests still allow cleartext; iOS
# allows only local networking). CI refuses to build an APK without https://.
EXPO_PUBLIC_SERVER_URL=http://localhost:4000
