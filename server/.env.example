# Copy to server/.env (git-ignored). docker compose reads it automatically.

# Your machine's Tailscale IP (tailscale ip -4). Both the server and Adminer
# bind ONLY to this address, so nothing is reachable off the tailnet.
# On the SG cutover this is the only line that changes for the tailnet profile.
TAILNET_IP=100.124.2.91

# Invite codes seeded at boot (idempotent, comma-separated). Optional.
INVITE_CODES=

# Place search upstream (R9). Defaults to the public Photon instance, which is
# free but "reasonable use only" and can throttle or ban. Point this at a
# self-hosted Photon on the homelab once the group leans on search.
# GEOCODER_URL=https://photon.komoot.io/api/
# Identify this deployment: the free geocoders' usage policies require it.
# GEOCODER_USER_AGENT=runs-app/1.0 (isaac; contact@example.com)
