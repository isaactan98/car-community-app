# Copy to server/.env (git-ignored). docker compose reads it automatically.

# Your machine's Tailscale IP (tailscale ip -4). Both the server and Adminer
# bind ONLY to this address, so nothing is reachable off the tailnet.
# On the SG cutover this is the only line that changes for the tailnet profile.
TAILNET_IP=100.124.2.91

# Invite codes seeded at boot (idempotent, comma-separated). Optional.
INVITE_CODES=
